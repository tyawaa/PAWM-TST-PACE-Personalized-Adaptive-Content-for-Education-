    "@react-navigation/native": "7.5.2",
    "@react-navigation/native-stack": "7.21.1",
    "expo": "~57.0.33",
    "expo-asset": "~57.0.21",
    "expo-font": "~57.0.4",
    "expo-splash-screen": "~57.0.11",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2"
